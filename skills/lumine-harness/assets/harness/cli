#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
  check)
    shift
    exec node "$ROOT/check.mjs" "$@"
    ;;
  generated)
    shift
    exec node "$ROOT/generated.mjs" "$@"
    ;;
  adapter)
    exec node "$ROOT/adapter-cli.mjs" adapter "${@:2}"
    ;;
  skills)
    exec node "$ROOT/adapter-cli.mjs" skills "${@:2}"
    ;;
  work-status)
    exec node "$ROOT/adapter-cli.mjs" work-status "${@:2}"
    ;;
  *)
    {
      echo "Usage:"
      echo "  ./.harness/cli check <docs|draft|design|plan|architecture|taste|stale-docs|adapters|all> [slug]"
      echo "  ./.harness/cli generated refresh <target|all>"
      echo "  ./.harness/cli adapter status <current|selected> [--json]"
      echo "  ./.harness/cli adapter list"
      echo "  ./.harness/cli adapter doctor <product|selected|all> [--json]  # 检查安装、工程配置和仍需完成的设置"
      echo "  ./.harness/cli adapter verify <product|selected|all> [--json]  # 汇总真实 Agent 会话产生的运行证据"
      echo "  ./.harness/cli adapter verify <product> --begin --host-version <version>"
      echo "  ./.harness/cli adapter <install|uninstall> <kimi|zcode|deepseek-harness>"
      echo "  ./.harness/cli skills <list|search|inspect> [query|name]"
      echo "  ./.harness/cli work-status <status> --product <product> --session-id <id>"
    } >&2
    exit 2
    ;;
esac
