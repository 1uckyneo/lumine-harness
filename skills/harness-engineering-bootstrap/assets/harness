#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
  check)
    shift
    exec node "$ROOT/.codex/harness-check.mjs" "$@"
    ;;
  generated)
    shift
    exec node "$ROOT/.codex/harness-generated.mjs" "$@"
    ;;
  *)
    {
      echo "Usage:"
      echo "  ./harness check <docs|draft|design|plan|architecture|taste|stale-docs|all> [slug]"
      echo "  ./harness generated refresh <workspace-index|repo-doc-index|api-map|db-schema|frontend-routes|frontend-components|all>"
    } >&2
    exit 2
    ;;
esac
