{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@lumine-hook:adapters/trae/hooks/session-start.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@lumine-hook:adapters/trae/hooks/stop.mjs",
            "timeout": 120
          }
        ],
        "loop_limit": 20
      }
    ]
  }
}
